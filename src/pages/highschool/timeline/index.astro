---
title: '高校野球 在籍年表';
description: '高校野球常連校の選手在籍年表と先輩後輩関係';
import Header from '../../../components/Header.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>高校野球 在籍年表</title>
    <style>
      @import './index.css';
    </style>
  </head>
  <body>
    <Header />
    <div class="header">
      <h1>📅 高校野球 在籍年表</h1>
      <p>常連校の選手在籍年表と先輩後輩関係</p>
    </div>

    <div class="container">
      <div class="navigation">
        <a href="/highschool/" class="nav-link">← 甲子園出場校リストに戻る</a>
      </div>

      <div class="controls">
        <div class="control-group">
          <label for="schoolSelect">学校選択:</label>
          <select id="schoolSelect">
            <option value="">学校を選択してください</option>
            <option value="yokohama">横浜高校</option>
            <option value="osaka-toin">大阪桐蔭高校</option>
            <option value="chiben-wakayama">智弁和歌山高校</option>
            <option value="sakushin-gakuin">作新学院高校</option>
            <option value="keio">慶應義塾高校</option>
            <option value="seiryo">星稜高校</option>
            <option value="koryo">広陵高校</option>
            <option value="riseisha">履正社高校</option>
            <option value="kendai-takasaki">健大高崎高校</option>
            <option value="hanasaki-tokuharu">花咲徳栄高校</option>
            <option value="meitoku-gijuku">明徳義塾高校</option>
            <option value="tenri">天理高校</option>
            <option value="aikodai-meiden">愛工大名電高校</option>
            <option value="kyushu-kokusai-daifu">九州国際大付高校</option>
            <option value="aomori-yamada">青森山田高校</option>
            <option value="kanto-daiichi">関東第一高校</option>
            <option value="kobe-kokusai-daifu">神戸国際大附高校</option>
            <option value="okinawa-shogaku">沖縄尚学高校</option>
            <option value="hokkai">北海高校</option>
            <option value="tohoku-gakuin">東北学院高校</option>
            <option value="nihon-bunri">日本文理高校</option>
            <option value="shizuoka">静岡高校</option>
            <option value="ichinoseki-gakuin">一関学院高校</option>
            <option value="meio">明桜高校</option>
            <option value="haguro">羽黒高校</option>
            <option value="gakuho-ishikawa">学法石川高校</option>
            <option value="kisarazu-sogo">木更津総合高校</option>
            <option value="nishogakusha-daifu">二松學舍大附高校</option>
            <option value="hokuriku">北陸高校</option>
            <option value="takaoka-sho">高岡商高校</option>
            <option value="saku-chosei">佐久長聖高校</option>
            <option value="shigakukan">至学館高校</option>
            <option value="gifu-sho">岐阜商高校</option>
            <option value="mie">三重高校</option>
            <option value="kyoto-kokusai">京都国際高校</option>
            <option value="kansai-soka">関西創価高校</option>
            <option value="omi">近江高校</option>
            <option value="soshi-gakuen">創志学園高校</option>
            <option value="ube-kojyo">宇部鴻城高校</option>
            <option value="tottori-sho">鳥取商高校</option>
            <option value="iwami-chisui-kan">石見智翠館高校</option>
            <option value="takamatsu-sho">高松商高校</option>
            <option value="teikyo-daiichi">帝京第五高校</option>
            <option value="naruto">鳴門高校</option>
            <option value="arita-ko">有田工高校</option>
            <option value="soseikan">創成館高校</option>
            <option value="kyushu-gakuin">九州学院高校</option>
            <option value="meiho">明豊高校</option>
            <option value="nobeoka-gakuen">延岡学園高校</option>
            <option value="kamimura-gakuen">神村学園高校</option>
          </select>
        </div>

        <div class="control-group">
          <label for="yearFilter">年代フィルター:</label>
          <select id="yearFilter">
            <option value="">全ての年代</option>
            <option value="1990s">1990年代</option>
            <option value="2000s">2000年代</option>
            <option value="2010s">2010年代</option>
            <option value="2020s">2020年代</option>
          </select>
        </div>
      </div>

      <div class="players-table-container">
        <div class="no-data" id="noData">学校を選択してください</div>
        <table class="players-table" id="playersTable" style="display: none;">
          <thead>
            <tr>
              <th>卒業年</th>
              <th>選手名</th>
              <th>現在の所属</th>
              <th>成績</th>
            </tr>
          </thead>
          <tbody id="playersTableBody"> </tbody>
        </table>
      </div>
    </div>

    <script>
      // 年代フィルター関数
      function filterByDecade(players, decade) {
        if (!decade) return players;

        const decadeRanges = {
          '1990s': [1990, 1999],
          '2000s': [2000, 2009],
          '2010s': [2010, 2019],
          '2020s': [2020, 2029],
        };

        const [start, end] = decadeRanges[decade];
        return players.filter(
          player =>
            player.graduationYear >= start && player.graduationYear <= end
        );
      }

      // テーブル表示
      async function displayPlayersTable(schoolName, yearFilter = null) {
        const playersTable = document.getElementById('playersTable');
        const playersTableBody = document.getElementById('playersTableBody');
        const noData = document.getElementById('noData');

        if (!schoolName) {
          playersTable.style.display = 'none';
          noData.style.display = 'block';
          return;
        }

        try {
          const module = await import(`./schoolPlayersData/${schoolName}.js`);
          const schoolPlayers = Object.values(module)[0];

          noData.style.display = 'none';
          playersTable.style.display = 'table';

          let players = schoolPlayers;
          if (yearFilter) {
            players = filterByDecade(players, yearFilter);
          }

          // 卒業年でソート
          players.sort((a, b) => b.graduationYear - a.graduationYear);

          // テーブルボディをクリア
          playersTableBody.innerHTML = '';

          players.forEach((player, index) => {
            const row = document.createElement('tr');

            // 卒業年セル
            const yearCell = document.createElement('td');
            const yearBadge = document.createElement('span');
            yearBadge.className = 'year-badge';
            yearBadge.textContent = player.graduationYear;
            yearCell.appendChild(yearBadge);

            // 選手名セル
            const nameCell = document.createElement('td');
            const playerName = document.createElement('div');
            playerName.className = 'player-name';
            playerName.textContent = player.name;
            nameCell.appendChild(playerName);

            // 現在の所属セル
            const teamCell = document.createElement('td');
            const teamSpan = document.createElement('span');
            teamSpan.className = 'current-team';
            teamSpan.textContent = player.currentTeam;
            teamCell.appendChild(teamSpan);

            // 成績セル
            const achievementCell = document.createElement('td');
            const achievementSpan = document.createElement('span');
            achievementSpan.className = 'achievement';
            achievementSpan.textContent = player.achievements;
            achievementCell.appendChild(achievementSpan);

            // 行に全てのセルを追加
            row.appendChild(yearCell);
            row.appendChild(nameCell);
            row.appendChild(teamCell);
            row.appendChild(achievementCell);

            // 遅延レンダリングでアニメーション効果
            row.style.opacity = '0';
            row.style.transform = 'translateY(20px)';

            playersTableBody.appendChild(row);

            // 遅延してアニメーションを実行
            setTimeout(() => {
              row.style.transition = 'all 0.5s ease';
              row.style.opacity = '1';
              row.style.transform = 'translateY(0)';
            }, index * 100);
          });
        } catch (error) {
          console.error('Error loading school players data:', error);
          playersTable.style.display = 'none';
          noData.style.display = 'block';
          noData.textContent = 'データの読み込みに失敗しました。';
        }
      }

      // 初期化関数
      async function initializeTimeline() {
        // URLから高校名を取得
        const urlParams = new URLSearchParams(window.location.search);
        const schoolFromUrl = urlParams.get('school');

        const schoolSelect = document.getElementById('schoolSelect');
        const yearFilter = document.getElementById('yearFilter');

        // イベントリスナー
        schoolSelect.addEventListener('change', async function () {
          const schoolName = this.value;
          const currentYearFilter = yearFilter.value;
          await displayPlayersTable(schoolName, currentYearFilter);
        });

        yearFilter.addEventListener('change', async function () {
          const schoolName = schoolSelect.value;
          const currentYearFilter = this.value;
          await displayPlayersTable(schoolName, currentYearFilter);
        });

        // URLに高校名があれば、それを選択して表示
        if (schoolFromUrl) {
          schoolSelect.value = schoolFromUrl;
          await displayPlayersTable(schoolFromUrl, yearFilter.value);
        } else {
          // 初期表示
          displayPlayersTable(schoolSelect.value);
        }
      }

      // DOM読み込み完了後に初期化
      document.addEventListener('DOMContentLoaded', initializeTimeline);
    </script>
  </body>
</html>

