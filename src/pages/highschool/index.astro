---
title: '高校野球 甲子園出場校リスト';
description: '高校野球甲子園出場校一覧';
import Header from '../../components/Header.astro';
import { koushienSchools as koushienSchools2024 } from './2024_koushienSchools.js';
import { koushienSchools as koushienSchools2023 } from './2023_koushienSchools.js';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>高校野球 甲子園出場校リスト</title>
    <style>
      @import './index.css';
    </style>
  </head>
  <body>
    <Header />
    <div class="header">
      <h1>⚾ 高校野球 甲子園出場校リスト</h1>
      <div class="year-selector">
        <label for="yearSelect">年度:</label>
        <select id="yearSelect">
          <option value="2024">2024年</option>
          <option value="2023">2023年</option>
        </select>
      </div>
      <p id="description">2024年夏の甲子園大会出場校（49校）</p>
    </div>

    <div class="container">
      <div class="school-table">
        <table id="schoolTable">
          <thead>
            <tr>
              <th>学校名</th>
              <th>都道府県</th>
              <th>説明</th>
            </tr>
          </thead>
          <tbody id="schoolTableBody"> </tbody>
        </table>
      </div>
    </div>

    <!-- データなしモーダル -->
    <div id="noDataModal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h3>📋 在籍年表データなし</h3>
        <p><span id="schoolNameInModal"></span>の在籍年表データは現在準備中です。</p>
        <p>データが追加され次第、ご利用いただけるようになります。</p>
      </div>
    </div>

    <script define:vars={{ koushienSchools2024, koushienSchools2023 }}>
      // timelineデータが存在する学校のリスト
      const schoolsWithTimelineData = new Set([
        'yokohama', 'osaka-toin', 'chiben-wakayama', 'sakushin-gakuin', 'keio',
        'seiryo', 'koryo', 'riseisha', 'kendai-takasaki', 'hanasaki-tokuharu',
        'meitoku-gijuku', 'tenri', 'aikodai-meiden', 'kyushu-kokusai-daifu',
        'aomori-yamada', 'kanto-daiichi', 'kobe-kokusai-daifu', 'okinawa-shogaku',
        'hokkai', 'tohoku-gakuin', 'nihon-bunri', 'shizuoka', 'ichinoseki-gakuin',
        'meio', 'haguro', 'gakuho-ishikawa', 'kisarazu-sogo', 'nishogakusha-daifu',
        'hokuriku', 'takaoka-sho', 'saku-chosei', 'shigakukan', 'gifu-sho',
        'mie', 'kyoto-kokusai', 'kansai-soka', 'omi', 'soshi-gakuen',
        'ube-kojyo', 'tottori-sho', 'iwami-chisui-kan', 'takamatsu-sho',
        'teikyo-daiichi', 'naruto', 'arita-ko', 'soseikan', 'kyushu-gakuin',
        'meiho', 'nobeoka-gakuen', 'kamimura-gakuen',
        // 2023年追加分
        'hachinohe-gakuin-kosei', 'morioka-dafu', 'sendai-ikuei', 'noshiro-shoyo',
        'tsuruoka-higashi', 'seiko-gakuin', 'maebashi-sho', 'shohei',
        'sendai-matsudo', 'chuetsu', 'tsuruga-kehi', 'ueda-nishi', 'kyoei',
        'hamamatsu-kaiseikan', 'toki-sho', 'kyoto-gaidai-nishi', 'okayama-sanyo',
        'chiben-gakuen', 'shimonoseki-kokusai', 'saibi', 'anan-hikari',
        'fukuoka-dai-ohori', 'karatsu-sho', 'nagasaki-nichidai', 'kumamoto-kokufu',
        'kitsuki', 'shonan'
      ]);

      // timelineデータの存在チェック
      function checkTimelineDataExists(romajiName) {
        return schoolsWithTimelineData.has(romajiName);
      }

      // URLパラメータ処理関数
      function getUrlParameter(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
      }

      function setUrlParameter(name, value) {
        const url = new URL(window.location);
        url.searchParams.set(name, value);
        window.history.replaceState({}, '', url);
      }

      // テーブルにデータを表示
      function displaySchools(schools) {
        const tableBody = document.getElementById('schoolTableBody');
        tableBody.innerHTML = '';

        for (const school of schools) {
          const row = document.createElement('tr');
          const schoolNameCell = document.createElement('td');
          const hasTimelineData = checkTimelineDataExists(school.romaji);
          
          schoolNameCell.textContent = school.name;
          
          if (hasTimelineData) {
            schoolNameCell.className = 'school-name has-timeline';
            schoolNameCell.addEventListener('click', () => {
              window.location.href = `/highschool/timeline/?school=${school.romaji}&year=${currentYear}`;
            });
          } else {
            schoolNameCell.className = 'school-name no-timeline';
            schoolNameCell.addEventListener('click', () => {
              showNoDataModal(school.name);
            });
          }

          const prefectureCell = document.createElement('td');
          prefectureCell.className = 'prefecture';
          prefectureCell.textContent = school.prefecture;

          const descriptionCell = document.createElement('td');
          descriptionCell.className = 'description';
          descriptionCell.textContent = school.description;

          row.appendChild(schoolNameCell);
          row.appendChild(prefectureCell);
          row.appendChild(descriptionCell);
          tableBody.appendChild(row);
        }
      }

      // ボタンのアクティブ状態を更新 (この関数は現在使用されていませんが、残しておきます)
      function updateActiveButton(activeButton) {
        document.querySelectorAll('.btn').forEach(btn => {
          btn.classList.remove('active');
        });
        if (activeButton) {
          activeButton.classList.add('active');
        }
      }

      // すべての学校を表示 (この関数は現在使用されていませんが、残しておきます)
      function showAllSchools(event) {
        displaySchools(koushienSchools);
        currentFilter = null;
        updateActiveButton(event.target);
      }

      // グローバルに関数を公開 (現在使用されていませんが、残しておきます)
      window.showAllSchools = showAllSchools;

      // モーダル表示・非表示機能
      function showNoDataModal(schoolName) {
        const modal = document.getElementById('noDataModal');
        const schoolNameSpan = document.getElementById('schoolNameInModal');
        schoolNameSpan.textContent = schoolName;
        modal.style.display = 'block';
        // アニメーション用のクラスを少し遅れて追加
        setTimeout(() => {
          modal.classList.add('show');
        }, 10);
      }

      function hideNoDataModal() {
        const modal = document.getElementById('noDataModal');
        modal.classList.remove('show');
        setTimeout(() => {
          modal.style.display = 'none';
        }, 300);
      }

      // 年度データ管理
      const yearData = {
        2024: koushienSchools2024,
        2023: koushienSchools2023
      };
      
      // URLパラメータから年度を取得、なければデフォルト値
      let currentYear = getUrlParameter('year') || '2024';
      
      // 年度選択時の処理
      function handleYearChange() {
        const yearSelect = document.getElementById('yearSelect');
        currentYear = yearSelect.value;
        const schools = yearData[currentYear];
        const description = document.getElementById('description');
        description.textContent = `${currentYear}年夏の甲子園大会出場校（49校）`;
        // URLパラメータも更新
        setUrlParameter('year', currentYear);
        displaySchools(schools);
      }
      
      // 初期表示
      document.addEventListener('DOMContentLoaded', function () {
        const yearSelect = document.getElementById('yearSelect');
        // URLパラメータから取得した年度でドロップダウンを設定
        yearSelect.value = currentYear;
        // 説明文も更新
        const description = document.getElementById('description');
        description.textContent = `${currentYear}年夏の甲子園大会出場校（49校）`;
        
        yearSelect.addEventListener('change', handleYearChange);
        displaySchools(yearData[currentYear]);

        // モーダルイベントリスナー
        const modal = document.getElementById('noDataModal');
        const closeBtn = document.querySelector('.close');

        // × ボタンクリックで閉じる
        closeBtn.addEventListener('click', hideNoDataModal);

        // モーダル外クリックで閉じる
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            hideNoDataModal();
          }
        });

        // ESCキーで閉じる
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal.style.display === 'block') {
            hideNoDataModal();
          }
        });
      });
    </script>
  </body>
</html>
